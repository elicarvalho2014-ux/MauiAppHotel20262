<ContentPage 
    x:Class="MauiAppHotel20262.Views.Sobre"
    Title="Sobre">

    <VerticalStackLayout 
                    Spacing="10"
                    Padding="20"
                    VerticalOptions="Start">

        <Label
            Text="Sobre"
            FontFamily="Orbitron"
            TextColor="{StaticResource Primary}"
            FontSize="40"
            Margin="0, 30, 0, 10"
            VerticalOptions="Center"
            HorizontalOptions="Center" />

        <Border StrokeShape="RoundRectangle 10"
                BackgroundColor="{StaticResource Gray100}">
            <VerticalStackLayout Spacing="20"
                                 Padding="20">

                <VerticalStackLayout Spacing="20">
                    <Label Text="➡ Desenvolvedor: Eli Carvalho" />
                    <Label Text="➡ Projeto do Curso de Desenvolvimento de Sistemas" />
                    <Label Text="➡ Aplicativo 'Calcular a Diária' foi desenvolvido em Outubro 2026" />

                </VerticalStackLayout>

            </VerticalStackLayout>

        </Border>

                <Button Text="Calcule a sua Diária"
                        HorizontalOptions="Center"
                        VerticalOptions="End"
                        Margin="0, 20, 0, 0"
                        Clicked="Button_Clicked" />

    </VerticalStackLayout>

</ContentPage>